{
  "manifest_version": 3,
  "name": "Flow Batch Generator",
  "version": "0.1.21",
  "description": "Generate dependency-aware image batches in Google Flow from prompts_batch.md.",
  "minimum_chrome_version": "148",
  "message_serialization": "structured_clone",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "offscreen",
    "scripting",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow.google/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Flow Batch Generator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/project/*",
        "https://flow.google/project/*"
      ],
      "js": [
        "flow/content-runtime.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "ui/panel.html"
  }
}
